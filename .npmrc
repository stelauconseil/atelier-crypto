# Font Awesome Pro (Kit) : le jeton n'est jamais commité.
# En local : export FONTAWESOME_PACKAGE_TOKEN=... (par ex. dans ~/.zshrc)
# Sur GitHub : secret d'Actions FONTAWESOME_PACKAGE_TOKEN
@awesome.me:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_PACKAGE_TOKEN}
